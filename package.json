{
  "name": "squareone-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/disk-manifest.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/disk-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:claims": "node scripts/lint-claims.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:forms": "tsx scripts/test-form-screen.ts",
    "test:projects": "tsx scripts/test-projects-cms.ts",
    "test:automation": "tsx scripts/test-automation.ts",
    "test:pages": "tsx scripts/test-page-content.ts",
    "check": "node scripts/disk-manifest.mjs --check && npx tsc --noEmit --incremental false && node scripts/lint-claims.mjs && node scripts/check-links.mjs",
    "images:add": "node scripts/add-images.mjs",
    "warm": "node scripts/warm.mjs",
    "cms:seed": "node --experimental-strip-types scripts/cms-seed.ts",
    "cms:import": "npx sanity dataset import sanity/seed/seed.ndjson production --missing"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@hookform/resolvers": "^5.2.2",
    "@next/mdx": "16.4.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.12.0",
    "@tailwindcss/typography": "^0.5.19",
    "botid": "^1.5.11",
    "framer-motion": "^12.34.5",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "next-mdx-remote": "^6.0.0",
    "next-sanity": "^13.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "resend": "^6.9.3",
    "sanity": "^6.12.0",
    "sharp": "^0.34.5",
    "styled-components": "^6.5.3",
    "yet-another-react-lightbox": "^3.29.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.0.3",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
