# Copy to .env.local for local development. Production values live in Vercel.

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_EMAIL=office@squareonepaving.com

# Public site URL for sitemap / OG tags
NEXT_PUBLIC_SITE_URL=https://squareonepaving.ca

# Sanity CMS — docs/CMS.md. Leave blank and the site renders its built-in content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared with the Sanity webhook that calls /api/revalidate?secret=…
SANITY_REVALIDATE_SECRET=
