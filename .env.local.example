# Copy to .env.local for local development. Production values live in Vercel.

# Contact form (Resend)
#   RESEND_API_KEY   required in production. With no key the route answers 503
#                    and the visitor is given the phone lines and a mailto,
#                    rather than a "thank you" for an email nobody sent.
#   CONTACT_FROM     must be an address on a domain VERIFIED in Resend. The root
#                    squareonepaving.com is (DKIM at resend._domainkey, bounces
#                    at send.squareonepaving.com, checked 9 Oct 2026), so the
#                    default noreply@squareonepaving.com works; send. is the
#                    bounce address, not a sender. Resend's records sit beside
#                    Google Workspace's; never edit the root MX or SPF.
#   CONTACT_EMAIL    where the enquiry lands (defaults to office@).
RESEND_API_KEY=
CONTACT_FROM=Square One <noreply@squareonepaving.com>
CONTACT_EMAIL=office@squareonepaving.com

# Spam screen for the quote form (lib/form-screen.ts, 9 Oct 2026)
#   ANTHROPIC_API_KEY    Claude Haiku reads each enquiry (phone numbers and
#                        email addresses taken out) and calls it genuine or
#                        spam. Unset, narrow backup rules decide instead.
#                        Production only; set a monthly spend limit on the key.
#   FORM_SCREENED_EMAIL  where held-back mail goes, marked "[Screened]".
#                        Unset, it goes to CONTACT_EMAIL, still marked.
#   FORM_SCREEN_MODEL    optional; defaults to claude-haiku-4-5-20251001.
ANTHROPIC_API_KEY=
FORM_SCREENED_EMAIL=

# Public site URL for sitemap / OG tags
NEXT_PUBLIC_SITE_URL=https://www.squareonepaving.com

# Sanity CMS — docs/CMS.md. Leave blank and the site renders its built-in content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# The Sanity webhook's signing secret (its Secret field), checked by
# /api/revalidate; never put it in the webhook's URL (docs/CMS.md, step 5)
SANITY_REVALIDATE_SECRET=

# Search Console / Bing Webmaster ownership by meta tag (optional; a DNS TXT record at the registrar is the better route)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
